# mcp-atlassian Inspector - Environment Variables
# Copy this file to .env and fill in your PAT token.
# Never put real values in this template.

# Confluence Data Center
CONFLUENCE_URL=https://espace.agir.orange.com
CONFLUENCE_PERSONAL_TOKEN=<your_confluence_personal_access_token>
CONFLUENCE_SSL_VERIFY=true

# Restrict to EPE space (optional - remove to access all spaces)
CONFLUENCE_SPACES_FILTER=EPE

# Safety: read-only mode (set to false to enable write operations)
READ_ONLY_MODE=true

# MCP Inspector auth token
MCP_PROXY_AUTH_TOKEN=mcp-inspector-token
