# MCP Inspector - Environment Variables
# Copy this file to .env and fill in your API tokens.
# SECURITY (M0, 2026-07-26): this template previously contained LIVE tokens.
# They were removed and must be treated as compromised. Never put real values here.

# Confluence (Atlassian DC)
CONFLUENCE_HOST=espace.agir.orange.com
CONFLUENCE_API_TOKEN=<your_confluence_api_token>

# Jira (Atlassian DC)
JIRA_HOST=portail.agir.orange.com
JIRA_API_TOKEN=<your_jira_api_token>

# GitLab
GITLAB_API_URL=https://gitlab.tech.orange/api/v4
GITLAB_API_TOKEN=<your_gitlab_personal_access_token>

# SonarQube
SONARQUBE_URL=https://sqaas.dos.tech.orange
SONARQUBE_API_TOKEN=<your_sonarqube_token>

# MCP Inspector auth token (used to access the UI)
MCP_PROXY_AUTH_TOKEN=mcp-inspector-token
